node_modules
dist
# The tree npm publishes, staged by the package builds (stagePublishTree)
packages/*/publish/
.env
.env.*
!.env.signing.example
.data
.DS_Store
.claude
.apack/

# Stale tsc output in source dirs (preload has no outDir)
packages/preload/src/**/*.js

# Test output
tests/results/

# Build output
native/speech/macos/SpeechHelper
build/prod/logs/

# The packaged-authoring check hands its work dir from the author half to the app half through here
tests/authoring-handoff/

# API Extractor's working directory: the regenerated reports `api:check` compares against, and the
# declarations it builds them from. Each package ignores its own, which `git` reads — but the root
# `oxlint .` reads *this* file for `--ignore-path`, and found 144 files with 17 errors under one of them when
# asked directly. It skips them today only by its own hidden-directory default, which is a tool's behaviour
# rather than something this repo declares
.temp/

# A config a bundler compiled to load it (`bundle-require`, through tsup), written beside the config for the
# length of a build. Ignored so a repo-wide walk that honours this file cannot enumerate one and then find it
# gone: oxlint reads `.` with `--ignore-path .gitignore`, and a cold chain failed once on exactly that race.
# `inputFiles` in @apackdev/host/build/packages-built skips the same pattern, for the walks that do not read this
*.bundled_*.mjs
*.bundled_*.cjs


# The elmdb checkout @apackdev/ears builds against, linked by `npm run link:elmdb` (scripts/link-elmdb.mjs); the
# commit it is pinned to is vendor/elmdb.rev
vendor/elmdb
