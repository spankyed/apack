{
  "$schema": "../apack-sdk/apack.schema.json",
  "id": "default-setup",
  "name": "Default Setup",
  "version": "0.1.0",
  "description": "The official apack starter pack. Provides core entity types, backend systems, services, frontend surfaces, artifacts, content data, message blocks, and default settings.",
  "license": "MIT",
  "builtIn": true,
  "hostVersion": ">=0.3.0",
  "data": {
    "relations": [
      "has",
      "relates_to"
    ]
  },
  "features": [
    {
      "id": "threads",
      "about": "Chat threads: messages, artifacts and the conversation UI.",
      "designation": "threads",
      "provides": [
        "system",
        "surface",
        "settings",
        "references"
      ],
      "surface": {
        "default": true
      },
      "entities": {
        "Thread": "be/types.ts#ThreadEntity",
        "Message": "be/types.ts#MessageEntity",
        "Artifact": "be/types.ts#ArtifactEntity"
      },
      "services": {
        "chat": "be/services/chat.ts#chatService",
        "artifact": "be/services/artifact.ts#artifactService",
        "threads": "be/services/threads.ts#threadsService"
      },
      "repositories": {
        "threadQueries": "be/repository/index.ts#threadQueries",
        "threadCommands": "be/repository/index.ts#threadCommands",
        "chatQueries": "be/repository/index.ts#chatQueries",
        "chatCommands": "be/repository/index.ts#chatCommands"
      }
    },
    {
      "id": "code",
      "about": "Terminals and coding agents (Claude Code, Codex) in an embedded shell.",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "entities": {
        "Terminal": "be/repository/index.ts#TerminalEntity"
      },
      "services": {
        "cli": "be/services/cli.ts#cliService",
        "codex": "be/services/codex/index.ts#codexService"
      },
      "repositories": {
        "terminalQueries": "be/repository/index.ts#terminalQueries",
        "terminalCommands": "be/repository/index.ts#terminalCommands"
      }
    },
    {
      "id": "notes",
      "about": "A hierarchical notebook of markdown notes.",
      "provides": [
        "system",
        "surface",
        "settings",
        "references"
      ],
      "entities": {
        "Note": "be/types.ts#NoteEntity"
      },
      "repositories": {
        "noteQueries": "be/repository/index.ts#noteQueries",
        "noteCommands": "be/repository/index.ts#noteCommands"
      }
    },
    {
      "id": "browser",
      "about": "An embedded browser with tabs and bookmarks.",
      "designation": "browser",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "entities": {
        "BrowserTab": "be/types.ts#BrowserTabEntity",
        "BrowserBookmark": "be/types.ts#BrowserBookmarkEntity"
      },
      "repositories": {
        "browserQueries": "be/repository/index.ts#browserQueries",
        "browserCommands": "be/repository/index.ts#browserCommands"
      }
    },
    {
      "id": "library",
      "about": "Documents and collections, with a dormant semantic search index.",
      "provides": [
        "system",
        "surface",
        "settings",
        "references"
      ],
      "entities": {
        "SearchIndex": null,
        "IndexedDoc": null,
        "Document": "be/types.ts#DocumentEntity",
        "Collection": "be/types.ts#CollectionEntity"
      },
      "services": {
        "library": "be/services/library.ts#libraryService"
      },
      "repositories": {
        "libraryQueries": "be/repository/index.ts#libraryQueries",
        "libraryCommands": "be/repository/index.ts#libraryCommands"
      }
    },
    {
      "id": "flows",
      "about": "The visual flow editor: flows, nodes and their wiring.",
      "provides": [
        "system",
        "surface",
        "settings",
        "types"
      ],
      "repositories": {
        "flowsQueries": "be/repository/index.ts#flowsQueries",
        "flowsCommands": "be/repository/index.ts#flowsCommands"
      }
    },
    {
      "id": "actions",
      "about": "Reusable code actions a flow step can run.",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "services": {
        "action": "be/services/action.ts#actionService"
      },
      "repositories": {
        "actionQueries": "be/repository/index.ts#actionQueries",
        "actionCommands": "be/repository/index.ts#actionCommands"
      }
    },
    {
      "id": "prompts",
      "about": "Reusable prompts an llm step can run.",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "services": {
        "prompt": "be/services/prompt.ts#promptService"
      },
      "repositories": {
        "promptQueries": "be/repository/index.ts#promptQueries",
        "promptCommands": "be/repository/index.ts#promptCommands"
      }
    },
    {
      "id": "brain",
      "about": "Runs flows: the scheduler, the run loop and the trace view.",
      "designation": "brain",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "services": {
        "brain": "be/services/brain.ts#brainService",
        "scheduler": "be/services/scheduler.ts#schedulerService"
      },
      "repositories": {
        "brainQueries": "be/repository/index.ts#brainQueries",
        "brainCommands": "be/repository/index.ts#brainCommands"
      }
    },
    {
      "id": "database",
      "about": "A console over the EARS store, with backup and restore.",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "services": {
        "database": "be/services/database.ts#databaseService"
      }
    },
    {
      "id": "logs",
      "about": "The app's log stream. Starts before EARS hydration so boot is captured.",
      "designation": "logs",
      "earlySystem": true,
      "provides": [
        "system",
        "surface",
        "settings"
      ]
    },
    {
      "id": "settings",
      "about": "App and per-surface settings, API keys and the pack list.",
      "designation": "settings",
      "provides": [
        "system",
        "surface",
        "settings"
      ],
      "entities": {
        "Settings": "be/types.ts#SettingsEntity"
      },
      "services": {
        "settings": "be/services/settings.ts#settingsService"
      },
      "repositories": {
        "settingsQueries": "be/repository/index.ts#settingsQueries",
        "settingsCommands": "be/repository/index.ts#settingsCommands"
      }
    }
  ],
  "extensions": {
    "steps": {
      "action": {
        "build": "src/extensions/steps/action/build.ts#actionStepBuild",
        "fe": "src/extensions/steps/action/fe.ts#actionStepFE",
        "runtime": {
          "handler": "src/extensions/steps/action/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "custom": true
        }
      },
      "llm": {
        "build": "src/extensions/steps/llm/build.ts#llmStepBuild",
        "fe": "src/extensions/steps/llm/fe.ts#llmStepFE",
        "runtime": {
          "handler": "src/extensions/steps/llm/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "primaryField": "prompt"
        }
      },
      "fire": {
        "build": "src/extensions/steps/fire/build.ts#fireStepBuild",
        "fe": "src/extensions/steps/fire/fe.ts#fireStepFE",
        "runtime": {
          "handler": "src/extensions/steps/fire/runtime.ts#handler"
        },
        "dsl": {
          "primaryField": "event"
        }
      },
      "subflow": {
        "build": "src/extensions/steps/subflow/build.ts#flowStepBuild",
        "fe": "src/extensions/steps/subflow/fe.ts#flowStepFE",
        "runtime": {
          "spawnsSubflow": true
        },
        "dsl": {
          "primaryField": "flow"
        }
      },
      "query": {
        "build": "src/extensions/steps/query/build.ts#queryStepBuild",
        "fe": "src/extensions/steps/query/fe.ts#queryStepFE",
        "runtime": {
          "handler": "src/extensions/steps/query/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "primaryField": "prompt"
        }
      },
      "create": {
        "build": "src/extensions/steps/create/build.ts#createStepBuild",
        "fe": "src/extensions/steps/create/fe.ts#createStepFE",
        "runtime": {
          "handler": "src/extensions/steps/create/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "primaryField": "entity"
        }
      },
      "update": {
        "build": "src/extensions/steps/update/build.ts#updateStepBuild",
        "fe": "src/extensions/steps/update/fe.ts#updateStepFE",
        "runtime": {
          "handler": "src/extensions/steps/update/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "primaryField": "target"
        }
      },
      "transform": {
        "build": "src/extensions/steps/transform/build.ts#transformStepBuild",
        "fe": "src/extensions/steps/transform/fe.ts#transformStepFE",
        "runtime": {
          "handler": "src/extensions/steps/transform/runtime.ts#handler",
          "isAsync": true
        },
        "dsl": {
          "primaryField": "script"
        }
      },
      "keep_alive": {
        "build": "src/extensions/steps/keep-alive/build.ts#keepAliveStepBuild",
        "fe": "src/extensions/steps/keep-alive/fe.ts#keepAliveStepFE",
        "runtime": {
          "handler": "src/extensions/steps/keep-alive/runtime.ts#handler",
          "waits": true
        },
        "dsl": {}
      },
      "kill": {
        "build": "src/extensions/steps/kill/build.ts#killStepBuild",
        "fe": "src/extensions/steps/kill/fe.ts#killStepFE",
        "runtime": {
          "handler": "src/extensions/steps/kill/runtime.ts#handler",
          "sync": true
        },
        "dsl": {
          "defaultLabel": "Kill Flow"
        }
      },
      "switch": {
        "build": "src/extensions/steps/switch/build.ts#switchStepBuild",
        "fe": "src/extensions/steps/switch/fe.ts#switchStepFE",
        "runtime": {
          "handler": "src/extensions/steps/switch/runtime.ts#handler"
        },
        "dsl": {
          "custom": true
        }
      },
      "schedule": {
        "kind": "trigger",
        "trigger": {
          "facet": "src/extensions/steps/schedule/build.ts#scheduleTriggerBuild",
          "register": "src/extensions/steps/schedule/runtime.ts#register"
        },
        "fe": "src/extensions/steps/schedule/fe.ts#scheduleTriggerFE"
      },
      "listener": {
        "kind": "trigger",
        "trigger": {
          "facet": "src/extensions/steps/listener/build.ts#listenerTriggerBuild"
        },
        "fe": "src/extensions/steps/listener/fe.ts#listenerTriggerFE"
      }
    },
    "artifacts": {
      "text": {
        "icon": "FileText",
        "fe": "src/extensions/artifacts/viewers/text-artifact.vue"
      },
      "code": {
        "icon": "Code",
        "fe": "src/extensions/artifacts/viewers/code-artifact.vue"
      },
      "review": {
        "icon": "CheckSquare",
        "fe": "src/extensions/artifacts/viewers/review-artifact.vue"
      },
      "image": {
        "icon": "Image",
        "fe": "src/extensions/artifacts/viewers/image-artifact.vue"
      },
      "slack": {
        "icon": "MessageSquare",
        "fe": "src/extensions/artifacts/viewers/slack-artifact.vue"
      },
      "todo": {
        "icon": "ListTodo",
        "fe": "src/extensions/artifacts/viewers/todo-artifact.vue"
      },
      "project": {
        "icon": "Layers",
        "fe": "src/extensions/artifacts/viewers/project-artifact.vue"
      },
      "json": {
        "icon": "FileText",
        "fe": "src/extensions/artifacts/viewers/json-artifact.vue"
      },
      "graph": {
        "icon": "Network",
        "fe": "src/extensions/artifacts/viewers/graph-artifact.vue"
      },
      "table": {
        "icon": "Table",
        "fe": "src/extensions/artifacts/viewers/table-artifact.vue"
      },
      "markdown": {
        "icon": "BookText",
        "fe": "src/extensions/artifacts/viewers/markdown-artifact.vue"
      },
      "claude-session": {
        "icon": "Wrench",
        "fe": "src/extensions/artifacts/viewers/claude-session-artifact.vue"
      },
      "codex-session": {
        "icon": "Bot",
        "fe": "src/extensions/artifacts/viewers/codex-session-artifact.vue"
      },
      "diff": {
        "icon": "GitBranch",
        "fe": "src/extensions/artifacts/viewers/diff-artifact.vue"
      },
      "plan": {
        "icon": "ClipboardList",
        "fe": "src/extensions/artifacts/viewers/plan-artifact.vue"
      },
      "note": {
        "icon": "StickyNote",
        "fe": "src/extensions/artifacts/viewers/note-artifact.vue"
      }
    },
    "blocks": {
      "prompt": {
        "fe": "src/extensions/blocks/display/PromptBlock.vue"
      },
      "note": {
        "fe": "src/extensions/blocks/display/NoteBlock.vue"
      },
      "markdown": {
        "fe": "src/extensions/blocks/display/MarkdownBlock.vue"
      },
      "link": {
        "fe": "src/extensions/blocks/display/LinkBlock.vue"
      },
      "tool-activity": {
        "fe": "src/extensions/blocks/display/ToolActivityBlock.vue"
      },
      "thinking": {
        "fe": "src/extensions/blocks/display/ThinkingBlock.vue"
      },
      "tool-input": {
        "fe": "src/extensions/blocks/display/ToolInputBlock.vue"
      },
      "context-usage": {
        "fe": "src/extensions/blocks/display/ContextUsageBlock.vue"
      },
      "session-list": {
        "fe": "src/extensions/blocks/display/SessionListBlock.vue"
      },
      "actions": {
        "kind": "input",
        "fe": "src/extensions/blocks/display/ActionButtons.vue"
      },
      "toggles": {
        "kind": "input",
        "fe": "src/extensions/blocks/display/TogglesBlock.vue"
      },
      "file-picker": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/FilePickerInput.vue"
      },
      "choice": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/ChoiceInput.vue"
      },
      "text": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/TextInput.vue"
      },
      "approval": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/ApprovalButtons.vue"
      },
      "button-group": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/ButtonGroupInput.vue"
      },
      "question": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/QuestionInput.vue"
      },
      "project-select": {
        "kind": "input",
        "fe": "src/extensions/blocks/input/ProjectSelectInput.vue"
      }
    },
    "commands": [
      {
        "name": "pr2md",
        "placeholder": "PR number or GitHub URL (optional)"
      },
      {
        "name": "instructions",
        "placeholder": "Thread instructions text"
      }
    ],
    "dsl": {
      "action": {
        "entry": "src/defs/action.ts",
        "targets": [
          "monaco"
        ],
        "prefix": "action:",
        "inline": [
          "ai",
          "@ai-sdk/provider",
          "@ai-sdk/provider-utils",
          "@ai-sdk/gateway",
          "@standard-schema/spec"
        ],
        "globals": {
          "services": "typeof _dsl.services",
          "z": "typeof _dsl.z",
          "flowId": "string"
        }
      },
      "prompt": {
        "entry": "src/defs/prompt.ts",
        "targets": [
          "monaco"
        ],
        "prefix": "prompt:",
        "globals": {
          "usePrompt": "typeof _dsl.usePrompt"
        }
      },
      "database": {
        "entry": "src/defs/database.ts",
        "targets": [
          "monaco"
        ],
        "prefix": "database:",
        "globals": {
          "EARS": "typeof _dsl.EARS",
          "query": "typeof _dsl.query",
          "getAllEntities": "typeof _dsl.getAllEntities",
          "getAll": "typeof _dsl.getAll",
          "findEntitiesByRelationTo": "typeof _dsl.findEntitiesByRelationTo",
          "findAttr": "typeof _dsl.findAttr",
          "getAttrs": "typeof _dsl.getAttrs",
          "getRoles": "typeof _dsl.getRoles",
          "getEntitiesOfType": "typeof _dsl.getEntitiesOfType",
          "findEntitiesByAttribute": "typeof _dsl.findEntitiesByAttribute",
          "findEntitiesInRelationTo": "typeof _dsl.findEntitiesInRelationTo",
          "findRelations": "typeof _dsl.findRelations",
          "getRelationStats": "typeof _dsl.getRelationStats",
          "getSchemaStats": "typeof _dsl.getSchemaStats",
          "create": "typeof _dsl.create",
          "upsert": "typeof _dsl.upsert",
          "write": "typeof _dsl.write",
          "destroyEntity": "typeof _dsl.destroyEntity",
          "prepareEntity": "typeof _dsl.prepareEntity",
          "createEntityWithDefaults": "typeof _dsl.createEntityWithDefaults",
          "updateEntity": "typeof _dsl.updateEntity",
          "createRelation": "typeof _dsl.createRelation",
          "removeRelation": "typeof _dsl.removeRelation",
          "removeRelationById": "typeof _dsl.removeRelationById",
          "grantRole": "typeof _dsl.grantRole",
          "revokeRole": "typeof _dsl.revokeRole"
        }
      }
    },
    "fe": {
      "textEditor": "src/extensions/tiptap/index.ts",
      "appExtensions": {
        "welcome": "src/extensions/app/Welcome.vue"
      }
    }
  },
  "content": {
    "sources": {
      "actions": {
        "path": "src/content/actions",
        "onUserEdit": "offer"
      },
      "prompts": {
        "path": "src/content/prompts",
        "onUserEdit": "offer"
      },
      "flows": {
        "path": "src/content/flows",
        "onUserEdit": "offer"
      },
      "library": {
        "path": "src/content/library",
        "format": "library"
      },
      "notes": {
        "path": "src/content/notes",
        "format": "notes"
      }
    },
    "artifacts": {
      "faqs": {
        "path": "src/content/faqs",
        "format": "faqs"
      }
    },
    "formats": {
      "notes": {
        "format": "markdown-tree",
        "entity": "Note",
        "identity": [
          "title",
          "parent"
        ],
        "tree": {
          "branch": "index.md",
          "relKind": "contains"
        },
        "fields": {
          "title": {
            "from": "frontmatter.title",
            "default": "filename",
            "type": "string"
          },
          "noteType": {
            "from": "frontmatter.type"
          },
          "icon": {
            "from": "frontmatter.icon",
            "default": null,
            "type": "string"
          },
          "favorite": {
            "from": "frontmatter.favorite"
          },
          "hideCompletedChildren": {
            "from": "frontmatter.hideCompletedChildren"
          },
          "completed": {
            "from": "frontmatter.completed"
          },
          "content": {
            "from": "body"
          }
        }
      },
      "library": {
        "compiler": "src/content/_compilers/library.ts",
        "entity": [
          "Collection",
          "Document"
        ],
        "identity": [
          "name"
        ],
        "media": "media"
      },
      "faqs": {
        "compiler": "src/content/_compilers/faqs.ts"
      }
    },
    "writers": {
      "Collection": "src/content/writers/library.ts#collectionWriter",
      "Document": "src/content/writers/library.ts#documentWriter",
      "Note": "src/content/writers/notes.ts#noteWriter"
    }
  },
  "lifecycle": "src/features/hooks.ts",
  "migrations": "src/migrations/index.ts",
  "build": {
    "opaqueDeps": [
      "elkjs"
    ]
  }
}
