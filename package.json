{
  "name": "abuddy",
  "description": "Vibe working platform",
  "version": "0.3.14",
  "private": true,
  "type": "module",
  "author": {
    "email": "angel.santiago@tutanota.com",
    "name": "Angel Santiago",
    "url": "https://clientlabs.com"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "preinstall": "[ \"$NODE_ENV\" = 'production' ] && echo '⚠️  NODE_ENV=production — devDependencies will be skipped. Run: unset NODE_ENV' >&2 || true",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "npm run build -ws --if-present",
    "build-prod": "sh build/build.sh",
    "prod-app": "sh build/prod/run.sh",
    "clean-prod": "sh build/prod/clean.sh",
    "diagnostics:prod": "node build/prod/diagnostics.mjs",
    "verify-signing": "sh build/prod/verify-signing.sh",
    "release": "sh build/release/release.sh",
    "unrelease": "bash build/release/unrelease.sh",
    "release:minor": "sh build/release/release.sh minor",
    "release:major": "sh build/release/release.sh major",
    "release:no-migrate": "sh build/release/release.sh --skip-migration-check",
    "build-prod:signed": "sh -c 'set -a; . ./.env.signing; set +a; sh build/build.sh'",
    "rebuild": "cd packages/api && npm rebuild",
    "package:all": "electron-builder --mac --win --linux",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "test:unit": "npm test --workspace @app/api && npm test --workspace @app/default-setup",
    "start": "SKIP_DEFS_GEN=1 npm run build:be && node packages/dev-mode.js",
    "start:gen": "npm run build:be && node packages/dev-mode.js",
    "start:inspect": "npm run build:be && ELECTRON_INSPECT=true node packages/dev-mode.js",
    "start:no-build": "node packages/dev-mode.js",
    "build:be": "npm run build --workspace @app/api",
    "prebuild:be": "npm run compile",
    "typecheck": "npm run typecheck:fe && npm run typecheck:be && echo '✅ All type checks passed!'",
    "typecheck:fe": "npm run type-check --workspace @app/renderer && echo '✅ Frontend type check passed'",
    "typecheck:be": "cd packages/api && npx tsc -p . --noEmit && echo '✅ Backend type check passed'",
    "rebuild:dev": "cd packages/api && npm rebuild",
    "db:cli": "cd packages/api && npm run db:cli",
    "db:exec": "cd packages/api && npm run db:exec",
    "db:reset": "cd packages/api && npm run db:reset",
    "db:script": "cd packages/api && npm run db:script",
    "compile": "npm run compile:settings && npm run compile:actions && npm run compile:prompts && npm run compile:flows && npm run compile:library && npm run compile:notes",
    "compile:prod": "npm run compile && npm run compile:faq",
    "compile:settings": "npm run compile:settings --workspace @app/default-setup",
    "compile:actions": "npm run compile:actions --workspace @app/default-setup",
    "compile:prompts": "npm run compile:prompts --workspace @app/default-setup",
    "compile:flows": "npm run compile:flows --workspace @app/default-setup",
    "compile:library": "npm run compile:library --workspace @app/default-setup",
    "compile:notes": "npm run compile:notes --workspace @app/default-setup",
    "compile:faq": "npm run compile:faq --workspace @app/default-setup",
    "build:speech-macos": "cd native/speech/macos && bash build.sh",
    "public-release": "bash build/release/publish-release.sh",
    "video:studio": "npm run studio --workspace @app/video",
    "video:render": "npm run render --workspace @app/video",
    "video:render:square": "npm run render:square --workspace @app/video",
    "video:render:component": "npm run render:component --workspace @app/video",
    "video:render:demos": "npm run render:demos --workspace @app/video",
    "video:review:snapshots": "npm run review:snapshots --workspace @app/video",
    "video:verify": "npm run verify --workspace @app/video",
    "video:audit:fidelity:strict": "npm run audit:fidelity:strict --workspace @app/video"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "4.0.2",
    "@playwright/test": "1.54.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "24.1.0",
    "@types/ws": "^8.18.1",
    "create-vite": "7.0.3",
    "electron": "37.2.4",
    "electron-builder": "26.0.12",
    "glob": "11.0.3",
    "playwright": "^1.54.1",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@app/api": "*",
    "@app/main": "*"
  }
}
