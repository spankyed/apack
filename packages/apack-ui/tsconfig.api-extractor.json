{
  // @apackdev/sdk and @elmdb/ears resolve to their published declarations, not source: API
  // Extractor analyses .d.ts files, and a dependency read as source is followed into it instead
  // of being reported as an import. Run npm run packages:build first.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise", "ESNext.Error", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [".temp/api-types/**/*.d.ts"]
}
