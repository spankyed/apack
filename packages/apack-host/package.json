{
  "name": "@apackdev/host",
  "version": "0.1.0",
  "private": true,
  "description": "Host-only modules shared by the apack app, CLI and test fixture",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sdk-modules:check": "npm test -- tests/packs/runtime/sdk-bridge-drift.spec.ts",
    "sdk-modules:update": "tsx scripts/sdk-modules.ts"
  },
  "exports": {
    "./app-state": "./src/app-state/index.ts",
    "./backup": "./src/backup/index.ts",
    "./build/compiler-inputs": "./src/build/compiler-inputs/index.ts",
    "./build/compiler-test-host": "./src/build/compiler-test-host.ts",
    "./build/discover": "./src/build/discover.ts",
    "./build/package-inputs": "./src/build/package-inputs.ts",
    "./build/pack-build-inputs": "./src/build/pack-build-inputs.ts",
    "./build/pack-inputs": "./src/build/pack-inputs.ts",
    "./build/pack-workdir": "./src/build/pack-workdir.ts",
    "./build/own-module-specifiers": "./src/build/own-module-specifiers.ts",
    "./build/packages-built": "./src/build/packages-built.ts",
    "./build/published-manifest": "./src/build/published-manifest.ts",
    "./build/shared-deps": "./src/build/shared-deps.ts",
    "./build/source-resolution": "./src/build/source-resolution.ts",
    "./build/specifiers": "./src/build/specifiers.ts",
    "./build/subpath-imports": "./src/build/subpath-imports.ts",
    "./bus": "./src/bus/index.ts",
    "./database": "./src/database/index.ts",
    "./dev-session": "./src/dev-session.ts",
    "./exclusive-lock": "./src/exclusive-lock.ts",
    "./replace-dir": "./src/replace-dir.ts",
    "./fe": "./src/fe/index.ts",
    "./features": "./src/features/index.ts",
    "./logs": "./src/logs.ts",
    "./migrations": "./src/migrations/index.ts",
    "./packs": "./src/packs/index.ts",
    "./packs/assets": "./src/packs/assets.ts",
    "./packs/dev-server": "./src/packs/dev-server.ts",
    "./packs/runtime": "./src/packs/runtime/index.ts",
    "./process-liveness": "./src/process-liveness.ts",
    "./private-file": "./src/private-file.ts",
    "./secrets": "./src/secrets/index.ts",
    "./secrets/vault": "./src/secrets/vault.ts",
    "./services": "./src/services/index.ts",
    "./testing": "./src/testing/pack-registry.ts",
    "./fe/testing": "./src/testing/frontend-registry.ts",
    "./settings": "./src/features/settings/be/index.ts",
    "./views": "./src/views/index.ts"
  },
  "dependencies": {
    "@apackdev/ears": "*",
    "@apackdev/sdk": "*",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/cohere": "^4.0.41",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/mistral": "^4.0.43",
    "@ai-sdk/openai": "^4.0.66",
    "@napi-rs/keyring": "^1.3.0",
    "ai": "^7.0.100",
    "fs-extra": "^11.4.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/semver": "^7.8.0"
  }
}
