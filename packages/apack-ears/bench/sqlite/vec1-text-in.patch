+static int vec1TextBytesCompare(const u8 *a, i64 na, const u8 *b, i64 nb){
+  i64 n = MIN(na, nb);
+  int cmp = n>0 ? memcmp(a, b, n) : 0;
+  return cmp ? cmp : COMPARE(na, nb);
+}
+
+static int vec1TextFilterCompare(const void *a, const void *b){
+  const Vec1Filter *pa = (const Vec1Filter*)a;
+  const Vec1Filter *pb = (const Vec1Filter*)b;
+  return vec1TextBytesCompare(pa->pPtr, pa->iVal, pb->pPtr, pb->iVal);
+}
