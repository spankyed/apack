{
  "name": "@apackdev/ears",
  "version": "0.1.0",
  "description": "EARS, the entity-attribute-relation store behind apack pack data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack.git",
    "directory": "packages/apack-ears"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:package": "tsx ../../scripts/build-package.ts .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "npm run build:package && vitest bench --run",
    "bench:heap": "npm run build:package && node --expose-gc bench/heap.ts",
    "api:build": "node -e \"require('fs').rmSync('.temp/api-types', { recursive: true, force: true })\" && tsc -p tsconfig.api-extractor.json",
    "api:check": "npm run api:build && tsx ../../scripts/api-reports.ts .",
    "api:update": "npm run api:build && tsx ../../scripts/api-reports.ts . --local"
  },
  "exports": {
    ".": {
      "@apackdev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./lmdb": {
      "@apackdev/source": "./src/lmdb/index.ts",
      "types": "./dist/lmdb/index.d.ts",
      "default": "./dist/lmdb/index.js"
    }
  },
  "peerDependencies": {
    "lmdb": "^3.5.9"
  },
  "peerDependenciesMeta": {
    "lmdb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "lmdb": "^3.5.9",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
