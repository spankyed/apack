{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/server.tsbuildinfo",
    // Workspace sources import .ts files by name; this config emits, which requires rewriteRelativeImportExtensions too
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    // tsup bundles the server as ESM
    "moduleResolution": "bundler",
    "module": "esnext"
  },
  "include": ["src"],
  "exclude": ["scripts/**/*"]
}
