{
  "name": "@app/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "scripts": {
    "build": "tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup --env.NODE_ENV development",
    "build:dev:watch": "cross-env-shell NODE_OPTIONS=--max-old-space-size=8192 tsup --env.NODE_ENV development --watch src --watch ../apack-host/src --watch ../apack-pack-format/src --watch ../apack-sdk/src",
    "dev:types": "tsc -p . --noEmit --watch --preserveWatchOutput",
    "dev:serve": "node ../../scripts/with-source.mjs tsx --watch src/server.ts",
    "start": "node ../../scripts/with-source.mjs node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [],
  "author": "angel santiago",
  "main": "dist/server.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": {
        "@apackdev/source": "./src/types.ts",
        "default": "./dist/types.d.ts"
      },
      "default": "./dist/server.js"
    },
    "./dist/*": "./dist/*"
  },
  "license": "ISC",
  "dependencies": {
    "@apackdev/clock": "0.1.0",
    "@apackdev/link": "0.1.0",
    "@apackdev/state": "0.1.0",
    "@apackdev/terminal": "0.1.0",
    "@elmdb/ears": "0.1.0",
    "@napi-rs/keyring": "^1.3.0",
    "@vscode/ripgrep": "^1.17.1",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "elmdb": "0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apackdev/host": "*",
    "@apackdev/pack-format": "*",
    "@apackdev/sdk": "*",
    "@types/node": "^24.12.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "msgpackr-extract": "^3.0.6"
  }
}
