{
  "name": "@apackdev/cli",
  "version": "0.1.0",
  "private": true,
  "description": "apack pack CLI: scaffold, build, test, pack and release packs",
  "type": "module",
  "bin": {
    "apack": "bin/apack.mjs"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "scripts": {
    "build:package": "tsx ../../scripts/bundle-package.ts .",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx ../../scripts/ensure-packages-built.ts",
    "test": "vitest run",
    "pretest:integration": "tsx ../../scripts/ensure-packages-built.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@apackdev/host": "*",
    "@apackdev/sdk": "*",
    "@octokit/rest": "^21.1.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.14",
    "chokidar": "^3.6.0",
    "env-paths": "^3.0.0",
    "esbuild": "^0.25.0",
    "get-tsconfig": "^4.13.7",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "semver": "^7.8.5",
    "tailwindcss": "^3.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vue": "^3.5.18",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "es-module-lexer": "^1.7.0",
    "@apackdev/ears": "*",
    "@apackdev/testing": "*",
    "@apackdev/ui": "*",
    "@app/publish-checks": "*",
    "@types/semver": "^7.8.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
