{
  "name": "@apackdev/sdk",
  "version": "0.1.0",
  "description": "Pack-facing API and types for apack packs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack.git",
    "directory": "packages/apack-sdk"
