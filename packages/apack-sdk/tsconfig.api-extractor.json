{
  // Dependencies resolve to their published declarations, not their source: API Extractor analyses
  // .d.ts files, and a dependency read as source is followed into it instead of being reported as
  // an import. Run npm run packages:build first.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise", "ESNext.Error", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".temp/api-types",
    "outDir": ".temp/api-types",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
