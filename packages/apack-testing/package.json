{
  "name": "@apackdev/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E fixture, vitest helpers and a unit test harness for apack packs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/package/dist/index.d.ts",
      "default": "./dist/package/dist/index.js"
    },
    "./playwright": {
      "types": "./dist/package/dist/playwright.d.ts",
      "default": "./dist/package/dist/playwright.js"
    },
    "./vitest": {
      "types": "./dist/package/dist/vitest.d.ts",
      "default": "./dist/package/dist/vitest.js"
    },
    "./harness": {
      "types": "./dist/package/dist/harness.d.ts",
      "default": "./dist/package/dist/harness.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api:build": "node -e \"require('fs').rmSync('.temp/api-types', { recursive: true, force: true })\" && tsc -p tsconfig.api-extractor.json",
    "api:check": "npm run api:build && tsx ../../scripts/api-reports.ts .",
    "api:update": "npm run api:build && tsx ../../scripts/api-reports.ts . --local",
    "build:package": "tsx ../../scripts/bundle-package.ts .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apackdev/ears": "*",
    "@apackdev/host": "*",
    "@apackdev/sdk": "*",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "playwright": ">=1.40.0",
    "playwright-core": ">=1.40.0",
    "vitest": ">=3.0.0",
    "@vitejs/plugin-vue": "^6.0.1"
  },
  "devDependencies": {
    "@trpc/server": "^11.1.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "ws": "^8.18.2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    }
  }
}
