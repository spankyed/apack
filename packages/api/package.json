{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "scripts": {
    "build": "tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup --env.NODE_ENV development",
    "build:dev:watch": "cross-env-shell NODE_OPTIONS=--max-old-space-size=8192 tsup --env.NODE_ENV development --watch src --watch ../apack-host/src --watch ../apack-sdk/src",
    "dev:types": "tsc -p . --noEmit --watch --preserveWatchOutput",
    "dev:serve": "node ../../scripts/with-source.mjs tsx --watch src/server.ts",
    "start": "node ../../scripts/with-source.mjs node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [],
  "author": "angel santiago",
  "main": "dist/server.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": {
        "@apackdev/source": "./src/types.ts",
        "default": "./dist/types.d.ts"
      },
      "default": "./dist/server.js"
    },
    "./dist/*": "./dist/*"
  },
  "license": "ISC",
  "dependencies": {
    "@apackdev/ears": "*",
    "@napi-rs/keyring": "^1.3.0",
    "elmdb": "file:../../vendor/elmdb/crates/elmdb-node",
    "@vscode/ripgrep": "^1.17.1",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "dotenv": "^16.5.0",
    "fs-extra": "^11.3.1",
    "node-pty": "^1.0.0",
    "ws": "^8.18.2",
    "xstate": "^5.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apackdev/host": "*",
    "@apackdev/sdk": "*",
    "@trpc/server": "^11.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
