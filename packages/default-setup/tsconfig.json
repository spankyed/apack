{
  "compilerOptions": {
    "noUnusedLocals": true,
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing. `incremental` works with `noEmit`; `composite` does not, which is why this
    // is not project references (docs/goals/goal-test-tiers.md).
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/default-setup.tsbuildinfo",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    // zod's z.infer degrades to all-optional without this, and boolean-literal
    // discriminants stop narrowing. Both are load-bearing here.
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "#generated/*": ["./src/__generated__/*"],
      "#features/*": ["./src/features/*"],
      "#extensions/*": ["./src/extensions/*"]
    }
  },
  // .vue files are checked by vue-tsc (npm run typecheck). src/defs/ (the Monaco DSL surfaces) is
  // checked here too; apack pack build bundles their declarations for the Monaco editors.
  "include": [
    "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"
  ]
}
