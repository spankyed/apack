{
  "name": "@app/default-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#generated/*": "./src/__generated__/*",
    "#features/*": "./src/features/*",
    "#extensions/*": "./src/extensions/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "pretest": "tsx ../../scripts/ensure-packages-built.ts",
    "test": "vitest run",
    "generate:entries": "apack pack generate-entries",
    "build": "apack pack build",
    "build:dev": "apack pack build --skip-fe",
    "facade:check": "apack pack facade-report",
    "facade:update": "apack pack facade-report --update",
    "flow-export:check": "npm test -- tests/extensions/steps/export-example.spec.ts",
    "flow-export:update": "UPDATE_FLOW_EXAMPLE=1 npm test -- tests/extensions/steps/export-example.spec.ts",
    "content-parity:check": "npm test -- tests/content",
    "content-parity:update": "UPDATE_CONTENT_GOLDEN=1 npm test -- tests/content"
  },
  "dependencies": {
    "@apackdev/ears": "*",
    "@apackdev/sdk": "*",
    "@apackdev/ui": "*",
    "@antv/g6": "^5.0.48",
    "@floating-ui/vue": "^1.1.11",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@vscode/ripgrep": "^1.17.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/minimap": "^1.5.3",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "diff": "8.0.4",
    "elkjs": "^0.9.0",
    "node-pty": "^1.0.0",
    "vue": "^3.5.18",
    "vue-arrange": "^1.5.0"
  },
  "devDependencies": {
    "@apackdev/testing": "*",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4",
    "zod": "^3.25.76",
    "@tiptap/core": "3.22.3",
    "@tiptap/starter-kit": "3.22.2",
    "jsdom": "^26.1.0",
    "tiptap-markdown": "^0.9.0",
    "@types/jsdom": "^21.1.7"
  }
}
