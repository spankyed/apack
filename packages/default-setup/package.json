{
  "name": "@app/default-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#generated/*": "./src/__generated__/*",
    "#features/*": "./src/features/*",
    "#extensions/*": "./src/extensions/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "pretest": "tsx ../../scripts/ensure-packages-built.ts",
    "test": "vitest run",
    "generate:entries": "apack pack generate-entries",
    "build": "apack pack build",
    "build:dev": "apack pack build",
    "facade:check": "apack pack facade-report",
    "facade:update": "apack pack facade-report --update",
    "plugin:check": "tsx scripts/build-native-plugin.ts",
    "plugin:update": "tsx scripts/build-native-plugin.ts --update",
    "flow-export:check": "npm test -- tests/extensions/steps/export-example.spec.ts",
    "flow-export:update": "UPDATE_FLOW_EXAMPLE=1 npm test -- tests/extensions/steps/export-example.spec.ts",
    "content-parity:check": "npm test -- tests/content",
    "content-parity:update": "UPDATE_CONTENT_GOLDEN=1 npm test -- tests/content"
  },
  "dependencies": {
    "@antv/g6": "^5.0.48",
    "@apackdev/ears": "*",
    "@apackdev/sdk": "*",
    "@apackdev/ui": "*",
    "@floating-ui/vue": "^1.1.11",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@vscode/ripgrep": "^1.17.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/minimap": "^1.5.3",
    "apack-git": "file:../../vendor/apack-git",
    "apack-terminal-view": "file:../../vendor/apack-terminal/view",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "diff": "8.0.4",
    "elkjs": "^0.9.0",
    "lowlight": "3.3.0",
    "vue": "^3.5.18",
    "vue-arrange": "^1.5.0"
  },
  "devDependencies": {
    "@apackdev/testing": "*",
    "@tiptap/core": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.0.4",
    "zod": "^4.6.7",
    "prosemirror-markdown": "^1.13.9"
  }
}
