{
  "compilerOptions": {
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing. `incremental` works with `noEmit`; `composite` does not, which is why this
    // is not project references (docs/goals/goal-test-tiers.md).
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/tsbuildinfo/tests.tsbuildinfo",
    // Workspace @apackdev/* packages resolve to source (see their package.json exports), as the
    // Playwright runner does under `npm test`; without it editors would read a stale dist
    "customConditions": ["@apackdev/source"],
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "../playwright.config.ts"]
}
