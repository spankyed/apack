{
  // Shared TypeScript baseline for workspace configs in this repository.
  // Empty `files` keeps this preset from compiling files on its own; child configs declare `include`.
  "files": [],
  "compilerOptions": {
    "target": "ES2024",
    "lib": [
      "ES2024",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise",
      "ESNext.Error",
      "ESNext.Disposable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  }
}
